# === AI Gateway (Nemotron) — used for CrewAI ===
AI_GATEWAY_URL=https://ai-gw.example.com/v1/chat/completions
AI_GATEWAY_BASE_URL=https://ai-gw.example.com/v1
AI_GATEWAY_API_KEY=sk-your-ai-gateway-api-key

# === Model for CrewAI ===
NEMOTRON_MODEL=qwen/qwen3-next-80b-a3b-instruct

# === FastAPI Gateway Security ===
GATEWAY_API_KEY=your-secret-api-key-here
ALLOWED_ORIGINS=http://localhost:3000

# === GLPI API ===
GLPI_URL=http://glpi.example.com
GLPI_APP_TOKEN=your-glpi-app-token
GLPI_USER_TOKEN=your-glpi-user-token

# === Mock Mode (set true for testing without GLPI) ===
MOCK_MODE=false
